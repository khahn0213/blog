rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // posts: 발행(published) 글은 누구나 읽을 수 있고,
    // 임시저장/예약 글은 로그인한 관리자만 읽을 수 있습니다.
    // 쓰기(작성/수정/삭제)는 로그인한 관리자만 가능합니다.
    match /posts/{postId} {
      allow read: if resource.data.status == 'published' || request.auth != null;
      allow create, update, delete: if request.auth != null;
    }

    // 그 외 컬렉션(카테고리, 태그, 댓글 등)은 추가할 때마다
    // 여기에 규칙을 하나씩 늘려갑니다 (start from small).
  }
}
